<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F7FAF9">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MinhQuan Mod"
        android:textColor="#23363B"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Menu nổi sẽ tự mở cùng Liên Quân Mobile"
        android:textColor="#607477"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/open_game"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mở Liên Quân Mobile"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#148373" />
</LinearLayout>
